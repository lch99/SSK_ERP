{
  "name": "ssk-erp-backend",
  "version": "0.1.0",
  "description": "SSK ERP — REST API",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "demo-data": "node src/scripts/demoData.js",
    "reset-db": "knex migrate:rollback --all && knex migrate:latest",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "legacy:inspect": "node src/legacy/inspect.js",
    "legacy:import": "node src/legacy/import.js",
    "legacy:verify": "node src/legacy/verify.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "mysql2": "^3.22.5",
    "sharp": "0.35.5"
  }
}
