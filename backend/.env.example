# MySQL only, 8.0 or newer (the org chart and team reach use WITH RECURSIVE, tier credit JSON_TABLE).
PORT=3002
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ssk_erp
# `npm test` empties and fills these databases (their names must end in _test): the app's tables,
# and a made-up copy of the old ERP for the legacy import tests (made if missing)
# DB_TEST_NAME=ssk_erp_test
# DB_LEGACY_TEST_NAME=ssk_legacy_test
# Long random string that signs login tokens. Required.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5175
# Proxies to trust for client IPs, if the API sits behind a load balancer (Express "trust proxy" value)
# TRUST_PROXY=loopback
# true = no sign-in, everyone acts as superadmin (laptop demos only; refused in production)
# AUTH_DISABLED=true
# Business days are Malaysian days even when the server keeps UTC
# APP_TZ=Asia/Kuala_Lumpur
# How often (minutes) the time rules and clean-ups run; 0 = off (a copy of real data whose idle accounts must not lock yet)
# TIME_RULES_MINUTES=15
# Where uploaded files are kept (until object storage): a folder outside git, backed up with the database
# UPLOAD_DIR=./uploads

# The old phone app (Android/iOS ≤ 1.3.6) calls /v1 at api.subsaleking.com: point that name at this server.
# The address photos are linked from (the app can't use relative links); blank = the request's own host.
# PUBLIC_API_URL=https://api.subsaleking.com
# How long a phone stays signed in (a password change or a lock still signs it out at once)
# APP_TOKEN_EXPIRES_IN=90d
# Apps older than these are asked to update (once a new release is out); and the latest, for its "new version" note
# APP_MIN_VERSION_ANDROID=1.0.0
# APP_MIN_VERSION_IOS=1.0.0
# APP_LATEST_VERSION_ANDROID=
# APP_LATEST_VERSION_IOS=

# A restored copy of the current ERP's database, for `npm run legacy:inspect`,
# `legacy:import` and `legacy:verify`. Never the live server; a read-only account is best.
# LEGACY_DB_HOST=localhost
# LEGACY_DB_PORT=3306
# LEGACY_DB_USER=readonly
# LEGACY_DB_PASSWORD=
# LEGACY_DB_NAME=sinland_copy
