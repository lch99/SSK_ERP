# DB_CLIENT=sqlite uses a local file instead of MySQL (laptop preview only).
# MySQL must be 8.0 or newer (the org chart and team reach use WITH RECURSIVE).
DB_CLIENT=mysql
PORT=3002
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ssk_erp
# `npm run test:mysql` empties and fills this database (its name must end in _test)
# DB_TEST_NAME=ssk_erp_test
# Long random string that signs login tokens. Required.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5175
# Proxies to trust for client IPs, if the API sits behind a load balancer (Express "trust proxy" value)
# TRUST_PROXY=loopback
# true = no sign-in, everyone acts as superadmin (laptop demos only; refused in production)
# AUTH_DISABLED=true
# Business days are Malaysian days even when the server keeps UTC
# APP_TZ=Asia/Kuala_Lumpur

# A restored copy of the current ERP's database, for `npm run legacy:inspect`,
# `legacy:import` and `legacy:verify`. Never the live server; a read-only account is best.
# LEGACY_DB_HOST=localhost
# LEGACY_DB_PORT=3306
# LEGACY_DB_USER=readonly
# LEGACY_DB_PASSWORD=
# LEGACY_DB_NAME=sinland_copy
