# MySQL only, 8.0 or newer (the org chart and team reach use WITH RECURSIVE, tier credit JSON_TABLE).
PORT=3002
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ssk_erp
# `npm test` empties and fills these databases (their names must end in _test): the app's tables,
# and a made-up copy of the old ERP for the legacy import tests (made if missing)
# DB_TEST_NAME=ssk_erp_test
# DB_LEGACY_TEST_NAME=ssk_legacy_test
# Long random string that signs login tokens. Required.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5175
# Proxies to trust for client IPs, if the API sits behind a load balancer (Express "trust proxy" value)
# TRUST_PROXY=loopback
# true = no sign-in, everyone acts as superadmin (laptop demos only; refused in production)
# AUTH_DISABLED=true
# Business days are Malaysian days even when the server keeps UTC
# APP_TZ=Asia/Kuala_Lumpur
# How often (minutes) the time rules and clean-ups run; 0 = off (a copy of real data whose idle accounts must not lock yet)
# TIME_RULES_MINUTES=15
# Where uploaded files are kept (until object storage): a folder outside git, backed up with the database
# UPLOAD_DIR=./uploads
# Or object storage (any S3-compatible service): STORAGE=s3 and the bucket's details. S3_ENDPOINT only for
# non-Amazon services (e.g. https://<account>.r2.cloudflarestorage.com); S3_PREFIX = a folder in the bucket
# STORAGE=s3
# S3_BUCKET=
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PREFIX=erp/
# Error alerts: a Slack or Discord incoming webhook (or anything taking { text } JSON); an uptime service can watch GET /api/health
# ALERT_WEBHOOK=https://hooks.slack.com/services/…
# `npm run backup` (daily from cron): a compressed dump into BACKUP_DIR (ideally another disk) and, with STORAGE=s3,
# into the bucket under backups/; copies older than BACKUP_KEEP_DAYS go. MYSQLDUMP if it is not on the PATH.
# BACKUP_DIR=/var/backups/ssk-erp
# BACKUP_KEEP_DAYS=30
# MYSQLDUMP=/usr/bin/mysqldump
# The old ERP's file server, the only place `npm run legacy:copy-photos` fetches from
# OLD_FILES_HOSTS=storage.subsaleking.com

# The old phone app (Android/iOS ≤ 1.3.6) calls /v1 at api.subsaleking.com: point that name at this server.
# The address photos are linked from (the app can't use relative links); blank = the request's own host.
# PUBLIC_API_URL=https://api.subsaleking.com
# How long a phone stays signed in (a password change or a lock still signs it out at once)
# APP_TOKEN_EXPIRES_IN=90d
# Apps older than these are asked to update (once a new release is out); and the latest, for its "new version" note
# APP_MIN_VERSION_ANDROID=1.0.0
# APP_MIN_VERSION_IOS=1.0.0
# APP_LATEST_VERSION_ANDROID=
# APP_LATEST_VERSION_IOS=
# E-mail for password links (Forgot password, and "Send by e-mail" in the office's dialog): any SMTP server
# (Amazon SES, Mailgun, Google Workspace…). ERP_URL is the ERP's own address; links are built only from it.
# MAIL_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="SubSaleKing <no-reply@subsaleking.com>"
# ERP_URL=https://erp.subsaleking.com/
# Push notifications to the phone app (Firebase Cloud Messaging): the Firebase project's service account key
# (Firebase console → Project settings → Service accounts → Generate new private key). Keep the file outside git.
# FIREBASE_SERVICE_ACCOUNT=/etc/ssk/firebase-service-account.json
# How often (seconds) new notifications are pushed; 0 = off
# PUSH_SECONDS=20

# A restored copy of the current ERP's database, for `npm run legacy:inspect`,
# `legacy:import` and `legacy:verify`. Never the live server; a read-only account is best.
# LEGACY_DB_HOST=localhost
# LEGACY_DB_PORT=3306
# LEGACY_DB_USER=readonly
# LEGACY_DB_PASSWORD=
# LEGACY_DB_NAME=sinland_copy
# The client's /panel PostgreSQL (bios, socials, awards, registration, feature switches), for `npm run legacy:panel`
# PANEL_DB_URL=postgres://readonly:password@host:5432/subsaleking
